---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout sideBarActiveItemID="contact">
  <div class="pb-12 mt-5 max-w-2xl">
    <div class="text-4xl font-bold mb-2">Contact Me</div>
    <p class="mb-4">I'm available for embedded systems, robotics, and consulting. Reach me via:</p>

    <ul class="list-disc ml-6 mb-6">
      <li>Email: <a class="link" href="mailto:alextleo.business@gmail.com">alextleo.business@gmail.com</a></li>
      <li>LinkedIn: <a class="link" href="https://www.linkedin.com/in/alex-t-leonardi/" target="_blank" rel="noopener">LinkedIn profile</a></li>
      <li>GitHub: <a class="link" href="https://github.com/alextleo" target="_blank" rel="noopener">GitHub</a></li>
    </ul>

    <p class="mb-4">Alternatively, you can reach me via the contact form below.</p>

    <div class="mb-6">
      <form id="contact-form" action="https://formspree.io/f/moeqvyyw" method="POST" class="space-y-4">
        <label class="block">
          <span class="text-sm font-medium">Name</span>
          <input name="name" required class="input input-bordered w-full" />
        </label>
        <label class="block">
          <span class="text-sm font-medium">Email</span>
          <input type="email" name="email" required class="input input-bordered w-full" />
        </label>
        <label class="block">
          <span class="text-sm font-medium">Message</span>
          <textarea name="message" rows="5" required class="textarea textarea-bordered w-full"></textarea>
        </label>
        <button class="btn btn-primary" type="submit">Send message</button>
      </form>

      <br>
      
      <p id="form-success" class="hidden text-success mt-4">Thanks — your message has been sent. I will get back to you as soon as possible.</p>
      
      <br>

      <p class="text-sm text-gray-500 mt-2">Or send an email to <a class="link" href="mailto:alextleo.business@gmail.com">alextleo.business@gmail.com</a></p>
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form');
  const successMessage = document.getElementById('form-success');

  form.addEventListener('submit', async (event) => {
    event.preventDefault();

    const formData = new FormData(form);

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: formData,
        headers: {
          'Accept': 'application/json'
        }
      });

      if (response.ok) {
        form.reset();
        successMessage.classList.remove('hidden');
      } else {
        alert('Something went wrong. Please try again.');
      }
    } catch (error) {
      alert('Something went wrong. Please try again.');
    }
  });
</script>
